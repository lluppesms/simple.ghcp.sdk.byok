<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ManagedIdentity</RootNamespace>
    <UserSecretsId>managedidentity-byok-demo</UserSecretsId>
    <!-- GHCP001: BYOK BearerTokenProvider is still marked experimental in the Copilot SDK. -->
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="1.60.0" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.5" />
  </ItemGroup>

</Project>
